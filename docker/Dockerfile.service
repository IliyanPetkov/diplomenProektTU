# =====================================================================
# Multi-stage Dockerfile за Node.js микросервиси
# =====================================================================

# Stage 1: Build & Dependencies
FROM node:22-alpine3.20 AS builder
WORKDIR /app

# Копиране на манифестите за кеширане на слоевете
COPY package.json ./

# Инсталиране на production зависимости само при необходимост
# (Архитектурата използва нативни Node.js 22 модули с нула външни зависимости)
RUN mkdir -p /app/node_modules

# Stage 2: Production Minimal Image
FROM node:22-alpine3.20 AS runner
WORKDIR /app

# Сигурност: Стартиране с non-root потребител node (UID 1000)
ENV NODE_ENV=production
RUN chown -R node:node /app

COPY --chown=node:node package.json ./
COPY --chown=node:node src/ ./src/
COPY --chown=node:node migrations/ ./migrations/

USER node

# Healthcheck директива за Docker
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT:-8080}/health/live || exit 1

EXPOSE 8080
CMD ["node", "src/index.js"]
