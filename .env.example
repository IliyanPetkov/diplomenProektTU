# =====================================================================
# Конфигурационен файл с примерни стойности (Environment Variables)
# Облачна информационна система за съхранение и управление на файлове
# =====================================================================

# Общи настройки на средата
NODE_ENV=development
PORT_GATEWAY=8080
PORT_IDENTITY=8081
PORT_METADATA=8082
PORT_STORAGE=8083
PORT_SHARING=8084
PORT_REALTIME=8085
PORT_AUDIT=8086

# База данни (PostgreSQL за Docker среда / SQLite за локално тестване)
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=cloudfs_user
DB_PASSWORD=cloudfs_secure_pass_2026
DB_NAME=cloudfs_db
DB_SQLITE_PATH=./data/cloudfs.db

# Сигурност и JWT
JWT_SECRET=tu_sofia_kst_super_secret_jwt_key_minimum_32_bytes_long_2026
JWT_ACCESS_EXPIRATION_SEC=900
JWT_REFRESH_EXPIRATION_SEC=604800

# Обектно хранилище (S3 / MinIO)
S3_ENDPOINT=http://minio1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secure_2026
S3_BUCKET_NAME=cloudfs-data
STORAGE_REDUNDANCY_NODES=./storage_nodes/node1,./storage_nodes/node2,./storage_nodes/node3,./storage_nodes/node4

# Ограничения и квоти
DEFAULT_USER_QUOTA_BYTES=104857600
MAX_UPLOAD_SIZE_BYTES=52428800
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# Логване
LOG_LEVEL=info
